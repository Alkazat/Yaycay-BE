# Yaycay Back-End - environment template. Copy to .env and fill in. Never commit .env.
# Secrets live server-side only (Supabase Edge Function secrets in deployed envs).

# App database (Postgres + RLS, Auth, Storage, Edge Functions)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Isolated identity store (dedicated project or locked-down identity schema)
IDENTITY_SUPABASE_URL=
IDENTITY_SERVICE_ROLE_KEY=

# Model-agnostic AI harness. Default for use-our-AI tier is Claude Sonnet.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Payments (Stripe Checkout + webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Marketing + transactional email (Brevo)
BREVO_API_KEY=

# BYO-AI MCP connector token signing
MCP_TOKEN_SIGNING_SECRET=

# Demo endpoint rate limiting (requests per IP per window)
DEMO_RATE_LIMIT_PER_HOUR=20
