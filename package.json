{
  "name": "@yaycay/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Yaycay back-end: API, data, AI harness, MCP, payments. Owns the @alkazat/contracts handshake.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "contracts:gen": "npm run gen --workspace @alkazat/contracts",
    "contracts:validate": "npm run validate --workspace @alkazat/contracts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  }
}
